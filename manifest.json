{
  "manifest_version": 3,
  "name": "Table Export for Grafana",
  "version": "0.1.0",
  "description": "Export a full Grafana table, in Explore or a dashboard, as Markdown, CSV, TSV, JSON or plain text. Copy it or download a file.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Table Export for Grafana",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*.grafana.net/*"],
      "js": ["src/page/exportFormats.js", "src/page/grafanaFrames.js", "src/page/exportMenu.js", "src/page/pageEntry.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
